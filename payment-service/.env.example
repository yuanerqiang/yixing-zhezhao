# Waffo Pancake test credentials
WAFFO_MERCHANT_ID=MER_2OQMrd8l0ksaNG5fqEsoFv
WAFFO_STORE_ID=STO_14uqwxjHayQ7dWBFyAh2Xm
WAFFO_PRIVATE_KEY="<paste-your-private-key>"

# Use "test" during development. Switch to "prod" only with production credentials.
WAFFO_ENVIRONMENT=test

# Create this with: npm run setup:product -- --amount 9.90 --currency USD
WAFFO_ONETIME_PRODUCT_ID=

# Local payment service settings
WAFFO_CURRENCY=USD
WAFFO_HOST=127.0.0.1
WAFFO_PORT=8787

# For local checkout redirects this can stay on localhost.
# For Waffo webhooks, use your public HTTPS tunnel URL instead.
WAFFO_PUBLIC_BASE_URL=http://127.0.0.1:8787

# Optional overrides
WAFFO_TAX_CATEGORY=software
# WAFFO_BUYER_IDENTITY=stable-installation-id
# WAFFO_WEBHOOK_TOLERANCE_MS=300000
# WAFFO_DATA_DIR=data

# ============ 支付宝（Alipay）配置 ============
# 在支付宝开放平台 open.alipay.com 创建「网页&移动应用」并签约「电脑网站支付」后填写。
# ALIPAY_APP_ID=2021XXXXXXXXXXXX
# 应用私钥：支付宝开放平台密钥工具生成后，「应用私钥」原文（注意与平台的格式一致）。
# ALIPAY_PRIVATE_KEY="<paste-your-alipay-private-key>"
# 支付宝公钥：在应用详情「接口加签方式」里复制支付宝公钥。
# ALIPAY_PUBLIC_KEY="<paste-your-alipay-public-key>"
# 密钥格式：密钥工具生成的通常是 PKCS8；若你的密钥是 PKCS1 开头为 "-----BEGIN RSA PRIVATE KEY-----" 则填 PKCS1
# ALIPAY_KEY_TYPE=PKCS8
# 环境：test = 沙箱（免费测试，默认）；prod = 正式收款。上线前必须改成 prod。
# ALIPAY_ENVIRONMENT=test
# 若使用沙箱，默认网关为 openapi-sandbox.dl.alipaydev.com；正式为 openapi.alipay.com，一般无需手动设置。
# ALIPAY_GATEWAY=
# 单价（元，最多两位小数），修改后重启服务生效。
ALIPAY_AMOUNT=9.90
# 收银台展示的商品名称
ALIPAY_SUBJECT=学习遮罩
